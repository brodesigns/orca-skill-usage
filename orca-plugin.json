{
  "manifestVersion": 2,
  "id": "skill-usage",
  "name": "Skill Usage",
  "version": "0.1.0",
  "description": "Shows which skills, MCP servers, agents and plugins your agents really use, and which only cost context tokens. English and German. Local only, no tracking.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "skill-usage",
        "title": "Skill Usage",
        "icon": "blocks",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "hooks": [
      {
        "event": "agent.tool.after"
      }
    ],
    "events": [
      {
        "on": "workspace.changed"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "workspace:read"
    }
  ]
}
